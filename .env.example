# ============================================================
# TeleBuy.lk — Example Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# ============================================================

PORT=3000
BASE_URL=http://localhost:3000

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=telebuy_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# PayHere Mode: 'sandbox' for testing, 'live' for production
PAYHERE_MODE=sandbox

# PayHere Merchant Credentials
MERCHANT_ID=1238371
MERCHANT_SECRET=your_payhere_merchant_secret_here

# Admin Management API Key
ADMIN_SECRET_KEY=your_admin_secret_key_here
